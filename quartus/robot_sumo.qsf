set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY robot_sumo_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "09:08:11  NOVEMBER 27, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE ../constraints/robot_sumo.sdc
set_global_assignment -name VHDL_FILE ../src/sumo_pkg.vhd
set_global_assignment -name VHDL_FILE ../src/circuit_reset.vhd
set_global_assignment -name VHDL_FILE ../src/diviseur_frequence.vhd
set_global_assignment -name VHDL_FILE ../src/pwm_gen.vhd
set_global_assignment -name VHDL_FILE ../src/UART_RX.vhd
set_global_assignment -name VHDL_FILE ../src/UART_TX.vhd
set_global_assignment -name VHDL_FILE ../src/message_demarrage.vhd
set_global_assignment -name VHDL_FILE ../src/selection_mode.vhd
set_global_assignment -name VHDL_FILE ../src/detection_capteurs.vhd
set_global_assignment -name VHDL_FILE ../src/batterie_monitor.vhd
set_global_assignment -name VHDL_FILE ../src/fsm_combat.vhd
set_global_assignment -name VHDL_FILE ../src/suiveur_ligne.vhd
set_global_assignment -name VHDL_FILE ../src/robot_sumo_top.vhd
set_global_assignment -name QIP_FILE ../ip/adc_ctrl/synthesis/adc_ctrl.qip
set_location_assignment PIN_R8 -to clock_50
set_location_assignment PIN_G15 -to bp1_b
set_location_assignment PIN_A14 -to ir_gauche_b
set_location_assignment PIN_C14 -to ir_droit_b
set_location_assignment PIN_D16 -to uart_rx
set_location_assignment PIN_D14 -to uart_tx
set_location_assignment PIN_C15 -to mot_gauche_dir
set_location_assignment PIN_F15 -to mot_gauche_en
set_location_assignment PIN_D15 -to mot_droit_dir
set_location_assignment PIN_F14 -to mot_droit_en
set_location_assignment PIN_A10 -to adc_cs_n
set_location_assignment PIN_B10 -to adc_saddr
set_location_assignment PIN_A9 -to adc_sdat
set_location_assignment PIN_B14 -to adc_sclk
set_location_assignment PIN_A15 -to led[0]
set_location_assignment PIN_A13 -to led[1]
set_location_assignment PIN_B13 -to led[2]
set_location_assignment PIN_A11 -to led[3]
set_location_assignment PIN_D1 -to led[4]
set_location_assignment PIN_F3 -to led[5]
set_location_assignment PIN_B1 -to led[6]
set_location_assignment PIN_L3 -to led[7]